{
  "name": "stella-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stella v2 控制面（浏览器 WebUI 与桌面壳共用，design_docs/Stella GUI v2 与 WebUI 建设方案 v1.0.md）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",

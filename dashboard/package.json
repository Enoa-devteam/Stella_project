    "test:watch": "vitest",
    "sync:webui": "node sync-dist.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "apexcharts": "^7.5.1",
    "axios": "^1.21.1",
    "dompurify": "^3.5.0",
    "marked": "^18.2.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.6.5",
    "vue3-apexcharts": "^1.11.3",
    "vuetify": "^3.7.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~6.0.3",
    "vite": "^6.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
